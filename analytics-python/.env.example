# MODELO — não preencha com dados reais. Este arquivo VAI para o Git.
#
# Copie para ".env" (copy .env.example .env) e preencha lá. O ".env" é ignorado
# pelo .gitignore da raiz (padrão *.env); o ".env.example" NÃO é, porque termina
# em ".example" — senha colocada aqui é senha publicada.
#
# São as MESMAS credenciais que o backend Java usa em DB_USERNAME / DB_PASSWORD.
# Host e banco saem da connection string de Backend/src/main/resources/application.properties:
#   jdbc:postgresql://nortedata.postgres.database.azure.com:5432/postgres?sslmode=require

DB_HOST=nortedata.postgres.database.azure.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_SSLMODE=require

# Chave combinada com o backend. Vazio = sem chave (suficiente para rodar na sua máquina).
# Se preencher, o PythonEtlService no Java tem que mandar o mesmo valor no header X-ETL-Key.
ETL_API_KEY=
